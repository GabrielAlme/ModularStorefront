{
  "name": "modularstorefront",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server.js",
    "test": "node --env-file-if-exists=.env.test --test backend/tests/api.test.js",
    "smoke": "node --test backend/tests/smoke.test.js",
    "build": "vite build",
    "start": "node server.js",
    "heroku-postbuild": "npm run build"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "buffer": "^6.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-mosaic-component": "^7.1.0",
    "react-router-dom": "^7.18.4",
    "router": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
